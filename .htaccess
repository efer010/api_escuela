Options -Indexes

# Pasar la cabecera Authorization a PHP cuando Apache usa CGI/FastCGI.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preservar la cabecera Authorization durante la reescritura.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Nunca exponer código interno, migraciones ni scripts de consola.
    RewriteRule ^(?:app|bin|database|docs)(?:/|$) - [F,L]

    # Archivos y carpetas existentes se sirven directamente (CSS, JS, imágenes).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por el front controller.
    RewriteRule ^ index.php [L]
</IfModule>

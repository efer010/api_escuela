Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nunca exponer código interno, migraciones ni scripts de consola.
    RewriteRule ^(?:app|bin|database)(?:/|$) - [F,L]

    # Archivos y carpetas existentes se sirven directamente (CSS, JS, imágenes).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por el front controller.
    RewriteRule ^ index.php [L]
</IfModule>
